# -----------------------------------------------------------------------------
# DevPilot Backend Environment Configuration
# -----------------------------------------------------------------------------

# 1. PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5433/devpilot
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 2. OpenAI API Key (Required for RAG Embeddings and Chat Intelligence)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# 3. GitHub OAuth Application Credentials (Required for Login & Repo Ingestion)
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Authorization Callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# 4. Frontend Application URL (For CORS & OAuth Success Callbacks)
APP_FRONTEND_URL=http://localhost:3000

# 5. Encryption Secret Password for Encrypting GitHub Tokens in Database
APP_ENCRYPTION_PASSWORD=devpilot_secret_master_key_12345